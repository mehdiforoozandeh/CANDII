# build artifacts — `build/lib/` in particular is a stale DUPLICATE of every source file and
# will silently diverge from src/ after any edit.
build/
dist/
*.egg-info/
# the compiled leaderboard site — regenerated by `tools/leaderboard.py build`, deployed by CI
_site/
__pycache__/
*.pyc
.pytest_cache/

# SLURM job logs from validation runs. Note: this directory is `slurm/logs/`, NOT `logs/` —
# the parent repo's .gitignore:14-16 has unanchored `logs/`, `jobs/` and `models/` rules that
# would swallow it from above. Same reason the scripts live in slurm/ and not jobs/.
slurm/logs/

# Agent scratch. `.claude/worktrees/` holds whole extra checkouts of this repo — 1 MB each and
# growing — which an unfiltered `rsync ./` to the cluster will happily carry along.
.claude/

# Recorded golden references (`tools/golden.py save`). Machine-local by design: the point is to
# record the tree in front of you and check the next edit against it, so a committed one would
# be a stale claim about somebody else's checkout.
*.golden*.pt
.golden_*.pt

# Obsidian UI state. `workspace.json` rewrites itself every time a pane moves, so tracking it
# turns every session into a diff. The other .obsidian files are real shared config and stay.
# Unanchored on purpose: `cruxvault/` is its own Obsidian vault with its own `.obsidian/`, and a
# leading-`.obsidian/` rule would only ever match the one at the repo root.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache

# The crux vault is tracked — except these two, which are why the old repo became unmanageable.
# `raw/` is 332 MB of source PDFs; it lives on the laptop that reads them and is rebuildable
# from the tracked `cruxvault/wiki/.sources.tsv`. `results/<hid>/` is the small evidence rsync'd
# down from Fir — the report, its figures, the scored JSON — and it is untracked because the old
# repo's equivalent grew to 132 MB. Note `.sources.tsv` sits under `wiki/`, not `raw/`, so
# neither rule touches it; that is deliberate and is what keeps `raw/` reconstructible.
cruxvault/raw/
cruxvault/results/
